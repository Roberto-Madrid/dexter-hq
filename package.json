{
  "name": "dexter-hq",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint kernel adapters tests",
    "test": "vitest run tests/unit",
    "test:integration": "node scripts/ensure-integration-db.mjs && vitest run tests/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:live": "node scripts/run-live.mjs",
    "check:vendor": "bash scripts/check-vendor-neutral.sh",
    "check:briefs": "bash scripts/check-briefs.sh",
    "check:bundle": "bash scripts/check-bundle-fresh.sh",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "pg": "8.16.3",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
